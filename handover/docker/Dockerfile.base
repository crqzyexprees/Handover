# Base sandbox image: Ubuntu 22.04 with the common toolchain every CLI needs.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
# Prefer ~/.local/bin (Claude native layout) then system CLIs.
ENV PATH="/home/sandbox/.local/bin:/usr/local/bin:/usr/bin:/bin"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
        gnupg \
        zstd \
    # NodeSource provides an up-to-date Node.js (bundles npm) — used for Codex.
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Codex via npm (global). Rebuild this image after host CLI updates —
# Docker does not inherit host binaries or host API keys.
RUN npm install -g @openai/codex

# Claude Code native installer (same layout as host ~/.local/share/claude).
# Install as root into /root/.local, then relocate under /opt for the sandbox user.
# Do NOT bake credentials into the image — auth is copied at container start only.
RUN curl -fsSL https://claude.ai/install.sh | bash \
    && cp -a /root/.local/share/claude /opt/claude \
    && LATEST="$(ls -1 /opt/claude/versions | sort -V | tail -n1)" \
    && test -n "$LATEST" \
    && test -x "/opt/claude/versions/${LATEST}" \
    && ln -sfn "/opt/claude/versions/${LATEST}" /usr/local/bin/claude \
    && chmod -R a+rX /opt/claude \
    && rm -rf /root/.local /root/.claude

# Cursor CLI (cursor-agent / agent): relocate out of root's ~/.local onto PATH.
RUN curl https://cursor.com/install -fsS | bash \
    && cp -a /root/.local/share/cursor-agent /opt/cursor-agent \
    && LATEST="$(ls -1 /opt/cursor-agent/versions | sort | tail -n1)" \
    && test -n "$LATEST" \
    && test -x "/opt/cursor-agent/versions/${LATEST}/cursor-agent" \
    && ln -sfn "/opt/cursor-agent/versions/${LATEST}/cursor-agent" /usr/local/bin/cursor-agent \
    && ln -sfn "/opt/cursor-agent/versions/${LATEST}/cursor-agent" /usr/local/bin/agent \
    && chmod -R a+rX /opt/cursor-agent \
    && rm -rf /root/.local

# Writable HOME for the sandbox process, which runs as the host's (non-root)
# UID. Host auth/config dirs are mounted in here read-only at runtime, and the
# CLIs need a writable HOME for their own state. World-writable because the
# runtime UID isn't known at build time; the container is ephemeral anyway.
# Seed ~/.local so Claude finds its native binary layout under $HOME.
RUN mkdir -p /home/sandbox/.local/bin /home/sandbox/.local/share \
    && ln -sfn /opt/claude /home/sandbox/.local/share/claude \
    && ln -sfn /usr/local/bin/claude /home/sandbox/.local/bin/claude \
    && chmod -R a+rwX /home/sandbox

WORKDIR /workspace

{
  "name": "handover",
  "private": true,
  "version": "1.0.8",
  "description": "Multi-terminal AI CLI orchestration with Docker sandboxes and project handoffs.",
  "author": "Handover",
  "type": "module",
  "scripts": {
    "dev": "vite --logLevel warn",
    "dev:tauri": "bash scripts/dev-tauri.sh",
    "build:backend": "cd ../handover_rust && cargo build --release",
    "build:backend:debug": "cd ../handover_rust && cargo build",
    "prepare:sidecar": "node scripts/prepare-backend-sidecar.js debug",
    "prepare:sidecar:release": "node scripts/prepare-backend-sidecar.js release",
    "icons": "python3 scripts/generate-icons.py",
    "build:docker-base": "bash ../handover/docker/build-base.sh",
    "build": "vite build",
    "build:tauri": "bash scripts/build-tauri-appimage.sh",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
